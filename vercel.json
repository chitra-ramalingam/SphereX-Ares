{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend/web-app && npm ci",
  "buildCommand": "cd frontend/web-app && npm run build",
  "outputDirectory": "frontend/web-app/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
